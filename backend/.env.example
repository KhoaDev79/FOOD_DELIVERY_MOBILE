# =====================================================================
# Cấu hình backend ZomZom. Sao chép thành .env rồi điền giá trị.
#
# BẮT BUỘC KHI DEPLOY PRODUCTION (xem docs/DEPLOY.md):
#   NODE_ENV=production
#   DATABASE_URL            -> URL Postgres thật (Neon / Postgres trên máy chủ)
#   JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, QUOTE_SECRET
#                           -> chuỗi NGẪU NHIÊN MỚI >= 32 ký tự, KHÔNG dùng giá trị change_me dưới đây
#                              (tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#   CORS_ORIGINS            -> domain web được phép gọi API (vd https://zomzom.duckdns.org); app di động không cần
#   VNPAY_RETURN_URL        -> link CÔNG KHAI tới /api/v1/payments/vnpay/return (không dùng localhost)
#   CLOUDINARY_*            -> để ảnh không mất khi máy chủ build lại
#   TRUST_PROXY=1           -> khi chạy sau Caddy/Nginx/Render, để giới hạn tần suất theo IP thấy đúng IP người dùng
# Tuỳ chọn: RUN_MIGRATIONS=false nếu không muốn container tự chạy prisma migrate deploy khi khởi động.
# =====================================================================

# ---- App ----
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*
# Giới hạn tần suất (đăng nhập sai, tạo đơn, dò mã voucher...). Chỉ đặt false khi chạy thử tải / test e2e.
RATE_LIMIT_ENABLED=true
# Số lớp proxy đứng trước backend (Caddy/Nginx/Render = 1). Để trống khi gọi thẳng vào backend.
TRUST_PROXY=

# ---- Database (local docker-compose; replace with Neon/Supabase URL in production) ----
DATABASE_URL=postgresql://food:food_secret@localhost:5433/food_delivery?schema=public

# ---- JWT & Quote (use long random strings, >= 32 chars) ----
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d
QUOTE_SECRET=change_me_quote_secret_at_least_32_chars

# ---- Delivery & Business rules ----
DELIVERY_BASE_FEE=15000
DELIVERY_FEE_PER_KM=5000
DELIVERY_FREE_KM=2
DELIVERY_PEAK_MULTIPLIER=1.2
DELIVERY_PEAK_WINDOWS=11:00-13:00,17:30-19:30
ROAD_DISTANCE_FALLBACK_FACTOR=1.3
QUOTE_TTL_MINUTES=10
PLATFORM_COMMISSION_RATE=0.2
DRIVER_DEBT_LIMIT=1000000
DRIVER_SEARCH_RADIUS_KM=5
DRIVER_LOCATION_STALE_MINUTES=5
DRIVER_OFFLINE_AFTER_MINUTES=15
MAX_ACTIVE_DELIVERIES=2
ORDER_PENDING_TIMEOUT_MINUTES=5
ORDER_PENDING_REMINDER_MINUTES=2
ORDER_STALLED_PICKUP_MINUTES=10
FAILED_DELIVERY_MIN_WAIT_MINUTES=10
FAILED_DELIVERY_MIN_CALLS=3
ARRIVAL_MAX_DISTANCE_M=200
CUSTOMER_MAX_FAILED_DELIVERIES=2
REVIEW_WINDOW_DAYS=7
AUTH_ACTIVE_CACHE_SECONDS=30

# ---- VNPay Sandbox (https://sandbox.vnpayment.vn/devreg) ----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Phải là URL public mà trình duyệt điện thoại truy cập được (vd: ngrok / Render URL)
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_EXPIRE_MINUTES=15
MOBILE_PAYMENT_REDIRECT=fooddelivery://payment-result

# ---- Chia sẻ quán/món ----
# Link bản web đã deploy (tuỳ chọn). Có thì trang chia sẻ /s/r/:id hiện thêm nút "Đặt món trên trình duyệt".
WEB_APP_URL=

# ---- Bản đồ ----
# nominatim (miễn phí, không cần khoá) hoặc goong (chính xác hơn ở VN, cần GOONG_API_KEY)
MAP_PROVIDER=nominatim
GOONG_API_KEY=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Expo Push (optional, only if "Enhanced security for push" is enabled) ----
EXPO_ACCESS_TOKEN=

# ---- Sentry ----
SENTRY_DSN=

# ---- Gemini (Trợ lý hỗ trợ khách hàng) ----
# Khoá tạo miễn phí tại https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Mã mô hình CHÍNH XÁC lấy trong AI Studio (dòng Flash-Lite)
GEMINI_MODEL=
# Số tin nhắn gửi trợ lý tối đa mỗi khách mỗi ngày
SUPPORT_BOT_DAILY_LIMIT=20
# Tự động tặng voucher bồi thường cho khiếu nại nhỏ của khách uy tín (đặt false để mọi khiếu nại chờ nhân viên duyệt)
SUPPORT_AUTO_COMPENSATION=true
# Thời gian chờ Gemini tối đa cho mỗi câu hỏi (ms); quá hạn thì dùng bot kịch bản
GEMINI_TIMEOUT_MS=20000
# Mức suy nghĩ của mô hình Gemini 3 (minimal = nhanh nhất). Để trống nếu mô hình không hỗ trợ
GEMINI_THINKING_LEVEL=minimal

# ---- Email quên mật khẩu (Gmail SMTP, miễn phí ~500 email/ngày) ----
# SMTP_USER: địa chỉ Gmail dùng để gửi; SMTP_PASS: MẬT KHẨU ỨNG DỤNG 16 ký tự (không phải mật khẩu Gmail)
# Tạo tại https://myaccount.google.com/apppasswords (tài khoản phải bật xác minh 2 bước)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=ZomZom
# Mã OTP đặt lại mật khẩu
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60

# ---- Đăng nhập bằng Google ----
# Các OAuth Client ID tạo tại https://console.cloud.google.com/apis/credentials (cách nhau dấu phẩy)
# Backend dùng để kiểm tra mã đăng nhập Google gửi từ app có đúng là của ứng dụng này không
GOOGLE_CLIENT_IDS=

# Chính sách huỷ đơn của khách: huỷ từ CUSTOMER_CANCEL_LIMIT đơn trong CUSTOMER_CANCEL_WINDOW_DAYS ngày
# thì tạm không đặt được đơn mới; từ lần huỷ thứ CUSTOMER_CANCEL_WARN_AT bắt đầu nhắc trước
CUSTOMER_CANCEL_LIMIT=4
CUSTOMER_CANCEL_WINDOW_DAYS=7
CUSTOMER_CANCEL_WARN_AT=2
