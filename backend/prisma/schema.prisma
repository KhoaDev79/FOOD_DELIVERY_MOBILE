generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  DRIVER
  ADMIN
}

enum RestaurantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING // Khách vừa đặt, chờ quán xác nhận
  CONFIRMED // Quán đã nhận đơn
  PREPARING // Quán đang chế biến
  READY_FOR_PICKUP // Món đã sẵn sàng, chờ tài xế lấy
  PICKED_UP // Tài xế đã lấy món, đang giao
  DELIVERED // Giao thành công
  DELIVERY_FAILED // Giao thất bại
  CANCELLED
}

enum CancelReason {
  CUSTOMER_CHANGED_MIND
  RESTAURANT_TIMEOUT // quán không nhận trong ORDER_PENDING_TIMEOUT_MINUTES
  RESTAURANT_OUT_OF_STOCK
  RESTAURANT_CLOSED
  RESTAURANT_OTHER
  ADMIN_INTERVENTION
  CUSTOMER_WRONG_ITEMS // khách đặt nhầm món / số lượng
  CUSTOMER_WRONG_ADDRESS // khách nhập sai địa chỉ
  CUSTOMER_WAIT_TOO_LONG // khách chờ quán xác nhận quá lâu
  CUSTOMER_FOUND_ALTERNATIVE // khách tìm được quán khác
  CUSTOMER_OTHER // lý do khác, bắt buộc ghi chú
}

enum FailedDeliveryReason {
  CUSTOMER_UNREACHABLE
  CUSTOMER_REFUSED
  WRONG_ADDRESS
  UNSAFE_LOCATION
}

enum DistanceSource {
  ROAD
  ESTIMATED
}

enum LedgerEntryType {
  COD_COLLECTED
  SETTLEMENT
  ADJUSTMENT
}

enum PaymentMethod {
  COD
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  REFUND_PENDING // đã thanh toán online nhưng đơn huỷ/giao thất bại: chờ admin hoàn tiền tay
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum VoucherType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIP
}

/// Ai chịu chi phí giảm giá: sàn (PLATFORM) hay quán (RESTAURANT, trừ vào doanh thu quán)
enum VoucherFunding {
  PLATFORM
  RESTAURANT
}

/// CAMPAIGN: mã khuyến mãi phát hành chung; COMPENSATION: voucher cá nhân bồi thường khiếu nại
enum VoucherKind {
  CAMPAIGN
  COMPENSATION
}

enum VehicleType {
  MOTORBIKE
  ELECTRIC_MOTORBIKE
  BICYCLE
}

enum DriverVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================ MODELS ============================

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  email               String   @unique
  /// Tên đăng nhập (chữ thường), mặc định lấy phần trước @ của email
  username            String?  @unique
  phone               String?  @unique
  /// Mã tài khoản Google (sub) khi đăng nhập bằng Google; null nếu chưa liên kết
  googleId            String?  @unique
  passwordHash        String
  fullName            String
  role                Role     @default(CUSTOMER)
  avatarUrl           String?
  /// Argon2 hash của refresh token hiện hành (rotation + revoke khi logout)
  refreshTokenHash    String?
  expoPushToken       String?
  isActive            Boolean  @default(true)
  failedDeliveryCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  addresses            Address[]
  restaurants          Restaurant[]             @relation("RestaurantOwner")
  approvedRestaurants  Restaurant[]             @relation("RestaurantApprover")
  orders               Order[]                  @relation("CustomerOrders")
  deliveries           Order[]                  @relation("DriverOrders")
  cancelledOrders      Order[]                  @relation("OrderCanceller")
  reviews              Review[]                 @relation("CustomerReviews")
  driverReviews        Review[]                 @relation("DriverReviews")
  driverProfile        DriverProfile?
  driverLedgers        DriverLedger[]           @relation("DriverLedgerUser")
  createdLedgers       DriverLedger[]           @relation("DriverLedgerActor")
  contactAttempts      DeliveryContactAttempt[]
  roleRequests         RoleUpgradeRequest[]     @relation("RoleRequestUser")
  reviewedRoleRequests RoleUpgradeRequest[]     @relation("RoleRequestReviewer")
  auditLogs            AuditLog[]               @relation("AuditActor")
  favorites            Favorite[]
  sentOrderMessages    OrderMessage[]           @relation("SentOrderMessages")
  chatReads            OrderChatRead[]
  notifications        Notification[]
  helpFeedbacks        HelpArticleFeedback[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  botConversations     BotConversation[]
  passwordResets       PasswordResetOtp[]
  personalVouchers     Voucher[]                @relation("PersonalVouchers")
  voucherUsages        VoucherUsage[]           @relation("VoucherUsages")
  authSessions         AuthSession[]

  @@map("users")
}

model Address {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  label             String // "Nhà", "Công ty"...
  addressLine       String
  latitude          Float
  longitude         Float
  isDefault         Boolean  @default(false)
  /// Đánh dấu địa chỉ do người dùng tự nhập tay thay vì chọn từ geocoding
  isManual          Boolean  @default(false)
  /// Đánh dấu địa chỉ toạ độ cũ cần người dùng mở ra xác nhận lại
  needsConfirmation Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Restaurant {
  id               String           @id @default(uuid()) @db.Uuid
  ownerId          String           @db.Uuid
  name             String
  description      String?
  imageUrl         String?
  phone            String?
  address          String
  latitude         Float
  longitude        Float
  /// Bán kính giao hàng tối đa của quán (km)
  deliveryRadiusKm Float            @default(5)
  status           RestaurantStatus @default(PENDING_APPROVAL)
  approvedAt       DateTime?
  approvedById     String?          @db.Uuid
  suspendReason    String?
  isOpen           Boolean          @default(true)
  /// Mốc thời gian tạm nghỉ có hẹn giờ. Hết thời gian này quán tự mở lại theo giờ.
  pausedUntil      DateTime?
  rating           Float            @default(0)
  ratingCount      Int              @default(0)
  openTime         String           @default("07:00")
  closeTime        String           @default("22:00")
  priceRange       String           @default("25.000đ - 85.000đ")
  /// Cờ đánh dấu nhà hàng thuộc bộ dữ liệu mẫu (không hiển thị thô trong tên quán)
  isSample         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner           User                       @relation("RestaurantOwner", fields: [ownerId], references: [id])
  approvedBy      User?                      @relation("RestaurantApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  reviews         Review[]
  favoritedBy     Favorite[]
  openingHours    RestaurantOpeningHour[]
  specialClosings RestaurantSpecialClosing[]
  vouchers        Voucher[]

  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([status])
  @@index([pausedUntil])
  @@map("restaurants")
}

model Category {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  name         String
  sortOrder    Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, name])
  @@map("categories")
}

model MenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @db.Uuid
  categoryId    String?  @db.Uuid
  name          String
  description   String?
  /// Giá tính bằng VND (số nguyên, tránh sai số float)
  price         Int
  discountPrice Int?
  imageUrl      String?
  options       Json?
  isAvailable   Boolean  @default(true)
  /// "Hết hôm nay": thời điểm tự mở bán lại (cron đặt lại isAvailable = true). null = hết đến khi quán bật lại
  soldOutUntil  DateTime?
  /// Khung giờ mở bán trong ngày dạng HH:mm (null = bán suốt giờ mở cửa của quán)
  availableFrom String?
  availableTo   String?
  /// Soft delete: giữ lại để OrderItem cũ vẫn tham chiếu được
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([soldOutUntil])
  @@map("menu_items")
}

model Order {
  id                  String                @id @default(uuid()) @db.Uuid
  customerId          String                @db.Uuid
  restaurantId        String                @db.Uuid
  driverId            String?               @db.Uuid
  status              OrderStatus           @default(PENDING)
  paymentMethod       PaymentMethod         @default(COD)
  paymentStatus       PaymentStatus         @default(UNPAID)
  subtotal            Int
  deliveryFee         Int
  peakSurcharge       Int                   @default(0)
  platformCommission  Int                   @default(0)
  driverEarning       Int                   @default(0)
  /// Giảm trên tiền món (mã giảm giá)
  discountAmount      Int                   @default(0)
  /// Giảm trên phí giao (mã freeship)
  shippingDiscount    Int                   @default(0)
  /// Phần giảm giá do quán chịu (trừ vào doanh thu quán)
  restaurantDiscount  Int                   @default(0)
  total               Int
  voucherId           String?               @db.Uuid
  voucherCode         String?               @db.VarChar(30)
  freeshipVoucherId   String?               @db.Uuid
  freeshipVoucherCode String?               @db.VarChar(30)
  distanceKm          Float
  distanceSource      DistanceSource        @default(ESTIMATED)
  deliveryAddress     String
  deliveryLat         Float
  deliveryLng         Float
  note                String?
  cancelReason        CancelReason?
  cancelNote          String?
  cancelledById       String?               @db.Uuid
  failedReason        FailedDeliveryReason?
  /// Thời điểm admin xác nhận đã hoàn tiền (đơn thanh toán online bị huỷ/giao thất bại)
  refundedAt          DateTime?
  /// Ghi chú hoàn tiền: mã giao dịch hoàn, kênh hoàn...
  refundNote          String?
  arrivedAt           DateTime?
  stalledAt           DateTime?
  estimatedDeliveryAt DateTime?
  idempotencyKey      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  customer        User                     @relation("CustomerOrders", fields: [customerId], references: [id])
  driver          User?                    @relation("DriverOrders", fields: [driverId], references: [id])
  cancelledBy     User?                    @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id])
  voucher         Voucher?                 @relation("OrderDiscountVoucher", fields: [voucherId], references: [id])
  freeshipVoucher Voucher?                 @relation("OrderFreeshipVoucher", fields: [freeshipVoucherId], references: [id])
  voucherUsages   VoucherUsage[]
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  transactions    PaymentTransaction[]
  review          Review?
  contactAttempts DeliveryContactAttempt[]
  ledgerEntry     DriverLedger?
  messages        OrderMessage[]
  chatReads       OrderChatRead[]
  supportTickets  SupportTicket[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([restaurantId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @db.Uuid
  menuItemId String  @db.Uuid
  /// Snapshot tên & giá tại thời điểm đặt (giá món có thể đổi sau này)
  name       String
  unitPrice  Int
  quantity   Int
  lineTotal  Int
  options    Json?
  note       String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Voucher {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique
  title             String
  description       String?
  discountType      VoucherType    @default(FIXED_AMOUNT)
  /// FIXED_AMOUNT: số tiền; PERCENTAGE: % (1–100); FREE_SHIP: mức giảm phí ship tối đa (0 = miễn toàn bộ)
  discountValue     Int
  maxDiscountAmount Int?
  minOrderAmount    Int            @default(0)
  /// Tổng số lượt dùng tối đa của mã
  maxUsage          Int            @default(100)
  usedCount         Int            @default(0)
  startDate         DateTime       @default(now())
  endDate           DateTime
  isActive          Boolean        @default(true)
  /// null = áp dụng toàn sàn; có giá trị = chỉ dùng ở quán này
  restaurantId      String?        @db.Uuid
  /// Voucher cá nhân (bồi thường): chỉ chủ tài khoản này dùng được
  userId            String?        @db.Uuid
  perUserLimit      Int            @default(1)
  onlyNewCustomer   Boolean        @default(false)
  fundedBy          VoucherFunding @default(PLATFORM)
  kind              VoucherKind    @default(CAMPAIGN)
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  restaurant     Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user           User?          @relation("PersonalVouchers", fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]        @relation("OrderDiscountVoucher")
  freeshipOrders Order[]        @relation("OrderFreeshipVoucher")
  usages         VoucherUsage[]

  @@index([isActive, endDate])
  @@index([restaurantId])
  @@index([userId])
  @@map("vouchers")
}

/// Mỗi lần một đơn dùng voucher. releasedAt != null nghĩa là đã hoàn lượt (đơn huỷ/giao thất bại).
model VoucherUsage {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @db.Uuid
  userId         String    @db.Uuid
  orderId        String    @db.Uuid
  discountAmount Int
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation("VoucherUsages", fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, orderId])
  @@index([voucherId, userId])
  @@index([orderId])
  @@map("voucher_usages")
}

model Banner {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  imageUrl    String
  /// NONE | RESTAURANT (actionValue = id quán) | CUISINE (= code danh mục) | SEARCH (= từ khoá). Giá trị cũ khác coi như NONE.
  actionType  String?   @default("RESTAURANT")
  actionValue String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  /// Lịch chạy: null = không giới hạn
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

model Review {
  id              String    @id @default(uuid()) @db.Uuid
  restaurantId    String    @db.Uuid
  customerId      String?   @db.Uuid
  orderId         String?   @unique @db.Uuid
  driverId        String?   @db.Uuid
  rating          Int       @default(5)
  comment         String?
  driverRating    Int?
  driverComment   String?
  /// Ảnh khách đính kèm (tối đa 3, link Cloudinary thư mục reviews)
  images          String[]  @default([])
  /// Ảnh bị chủ quán/admin ẩn vì không phù hợp (vẫn giữ để admin xem lại / hiện lại)
  hiddenImages    String[]  @default([])
  ownerReply      String?
  ownerRepliedAt  DateTime?
  driverReply     String?
  driverRepliedAt DateTime?
  isHidden        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   User?      @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: SetNull)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  driver     User?      @relation("DriverReviews", fields: [driverId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([driverId])
  @@map("reviews")
}

/// Mỗi đơn có tối đa 3 cuộc trò chuyện riêng, mỗi cuộc chỉ 2 bên:
/// khách–tài xế, khách–quán, quán–tài xế.
enum ChatChannel {
  CUSTOMER_DRIVER
  CUSTOMER_RESTAURANT
  RESTAURANT_DRIVER
}

model OrderMessage {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  channel    ChatChannel
  /// Tài xế của cuộc trò chuyện (chỉ với kênh có tài xế). Tài xế trả đơn thì tài xế mới không đọc được tin cũ.
  driverId   String?     @db.Uuid
  senderId   String      @db.Uuid
  senderRole Role
  content    String      @db.VarChar(1000)
  createdAt  DateTime    @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation("SentOrderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, channel, createdAt])
  @@map("order_messages")
}

/// Mốc đọc tin nhắn của từng người trong từng đơn: tin của người khác gửi sau mốc này là chưa đọc.
model OrderChatRead {
  orderId    String      @db.Uuid
  userId     String      @db.Uuid
  channel    ChatChannel
  lastReadAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orderId, userId, channel])
  @@index([userId])
  @@map("order_chat_reads")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  changedBy String?     @db.Uuid
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Mỗi lần khách bấm "Thanh toán VNPay" sinh 1 giao dịch với txnRef duy nhất.
/// IPN được xử lý idempotent dựa trên trạng thái của bản ghi này.
model PaymentTransaction {
  id            String                   @id @default(uuid()) @db.Uuid
  orderId       String                   @db.Uuid
  provider      PaymentMethod
  txnRef        String                   @unique
  amount        Int
  status        PaymentTransactionStatus @default(PENDING)
  responseCode  String?
  providerTxnNo String?
  bankCode      String?
  rawPayload    Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_transactions")
}

model DriverProfile {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @unique @db.Uuid
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType           VehicleType              @default(MOTORBIKE)
  vehicleBrand          String?
  vehicleModel          String?
  vehicleColor          String?
  licensePlate          String?                  @unique
  driverLicenseClass    String?
  verificationStatus    DriverVerificationStatus @default(PENDING)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedById          String?                  @db.Uuid
  isOnline              Boolean                  @default(false)
  lastLatitude          Float?
  lastLongitude         Float?
  lastLocationAt        DateTime?
  codBalance            Int                      @default(0)
  emergencyContactName  String?
  emergencyContactPhone String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@map("driver_profiles")
}

model DeliveryContactAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  driverId  String   @db.Uuid
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("delivery_contact_attempts")
}

model DriverLedger {
  id           String          @id @default(uuid()) @db.Uuid
  driverId     String          @db.Uuid
  orderId      String?         @unique @db.Uuid
  type         LedgerEntryType
  /// Dương = tài xế nợ thêm, âm = đã nộp/giảm nợ
  amount       Int
  balanceAfter Int
  note         String?
  createdById  String?         @db.Uuid
  createdAt    DateTime        @default(now())

  driver    User   @relation("DriverLedgerUser", fields: [driverId], references: [id], onDelete: Cascade)
  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("DriverLedgerActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@map("driver_ledgers")
}

/// Yêu cầu nâng cấp vai trò: khách hàng xin mở quán hoặc làm tài xế, admin duyệt.
model RoleUpgradeRequest {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  requestedRole Role
  status        RoleRequestStatus @default(PENDING)
  /// Thông tin kèm theo: tên quán dự kiến, địa chỉ, loại xe, biển số...
  metadata      Json?
  note          String?
  /// Lý do từ chối (nếu có)
  reviewNote    String?
  reviewedById  String?           @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User  @relation("RoleRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RoleRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("role_upgrade_requests")
}

/// Nhật ký thao tác quản trị (ai đã làm gì, với đối tượng nào).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  /// VD: RESTAURANT_ASSIGN_OWNER, USER_LOCK, USER_UNLOCK, USER_CHANGE_ROLE, ROLE_REQUEST_APPROVED
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

/// Quán yêu thích của từng tài khoản (mỗi người một danh sách riêng).
model Favorite {
  userId       String   @db.Uuid
  restaurantId String   @db.Uuid
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// Danh mục ẩm thực hệ thống (lối tắt danh mục trang chủ, lọc nhanh theo thể loại món).
model CuisineCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  keywords  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, isActive])
  @@map("cuisine_categories")
}

/// Nhật ký tìm kiếm của khách hàng (phục vụ xu hướng tìm kiếm phổ biến).
model SearchLog {
  id        String   @id @default(uuid()) @db.Uuid
  query     String
  createdAt DateTime @default(now())

  @@index([query, createdAt])
  @@map("search_logs")
}

/// Trung tâm thông báo hệ thống (đơn hàng, đánh giá, hệ thống, tài xế)
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String    @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Giờ mở cửa theo ngày trong tuần (0 = Chủ nhật, 1 = Thứ hai, ..., 6 = Thứ bảy). Hỗ trợ khung giờ qua đêm.
model RestaurantOpeningHour {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  dayOfWeek    Int // 0 = Chủ nhật, 1 = Thứ hai, ..., 6 = Thứ bảy
  openTime     String   @db.VarChar(5) // "07:00"
  closeTime    String   @db.VarChar(5) // "22:00"
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("restaurant_opening_hours")
}

/// Ngày nghỉ đặc biệt của quán (nghỉ lễ, Tết, sửa chữa...).
model RestaurantSpecialClosing {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  date         DateTime @db.Date
  reason       String?  @db.VarChar(200)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId, date])
  @@map("restaurant_special_closings")
}

// ============================ TRUNG TÂM TRỢ GIÚP & CHATBOT ============================

enum HelpAudience {
  CUSTOMER
  DRIVER
  OWNER
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageRole {
  CUSTOMER
  ADMIN
  BOT
  SYSTEM
}

/// Danh mục câu hỏi thường gặp (FAQ)
model HelpCategory {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(50)
  name      String       @db.VarChar(100)
  icon      String?      @db.VarChar(50)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  audience  HelpAudience @default(CUSTOMER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  articles HelpArticle[]

  @@index([audience, isActive, sortOrder])
  @@map("help_categories")
}

/// Bài viết trợ giúp / FAQ
model HelpArticle {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @db.Uuid
  title           String   @db.VarChar(200)
  body            String   @db.Text
  keywords        String[]
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category  HelpCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  feedbacks HelpArticleFeedback[]

  @@index([categoryId, isActive, sortOrder])
  @@index([isActive, viewCount(sort: Desc)])
  @@map("help_articles")
}

/// Đánh giá độ hữu ích của bài viết (mỗi user 1 lần/bài)
model HelpArticleFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @db.Uuid
  userId    String   @db.Uuid
  helpful   Boolean
  createdAt DateTime @default(now())

  article HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("help_article_feedbacks")
}

/// Phiếu yêu cầu hỗ trợ (Ticket)
model SupportTicket {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique @db.VarChar(20) // "HT-XXXX"
  userId          String                @db.Uuid
  orderId         String?               @db.Uuid
  category        String                @db.VarChar(50)
  subject         String                @db.VarChar(200)
  status          SupportTicketStatus   @default(NEW)
  priority        SupportTicketPriority @default(NORMAL)
  resolution      Json?
  csatScore       Int? // 1 - 5 sao
  csatComment     String?               @db.Text
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, priority, createdAt])
  @@index([orderId])
  @@map("support_tickets")
}

/// Tin nhắn trao đổi trong phiếu hỗ trợ
model SupportMessage {
  id          String             @id @default(uuid()) @db.Uuid
  ticketId    String             @db.Uuid
  senderId    String?            @db.Uuid
  senderRole  SupportMessageRole
  content     String             @db.Text
  attachments String[]
  createdAt   DateTime           @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Cuộc hội thoại với Trợ lý ảo (Chatbot)
model BotConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BotMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("bot_conversations")
}

/// Tin nhắn của Chatbot và khách (đã ẩn danh thông tin cá nhân)
model BotMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String   @db.VarChar(20) // user | assistant | system
  content        String   @db.Text
  source         String?  @db.VarChar(20) // GEMINI | SCRIPT | CACHE
  latencyMs      Int?
  feedback       String?  @db.VarChar(20) // HELPFUL | UNHELPFUL
  /// Thẻ hành động + gợi ý nhanh của tin bot, để mở lại lịch sử vẫn thấy nút
  meta           Json?
  createdAt      DateTime @default(now())

  conversation BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("bot_messages")
}

/// Phiên đăng nhập theo từng thiết bị (cho đăng nhập nhiều thiết bị cùng lúc).
/// epoch phải trùng users.refreshTokenHash: các chỗ "thu hồi mọi phiên" (khoá tài khoản, đổi vai trò,
/// đổi mật khẩu, xoá tài khoản) đặt cột đó về null nên mọi phiên cũ tự hết hiệu lực.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// Băm của refresh token hiện tại của phiên (xoay vòng mỗi lần làm mới)
  tokenHash  String
  epoch      String    @db.VarChar(64)
  deviceInfo String?   @db.VarChar(200)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Mã OTP quên mật khẩu gửi qua email. Chỉ lưu bản băm; mỗi lần gửi mã mới thì mã cũ hết hiệu lực.
model PasswordResetOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  /// Số lần nhập sai; đủ 5 lần thì mã bị khoá
  attempts   Int       @default(0)
  expiresAt  DateTime
  /// Lúc nhập đúng mã (bước 2); sau đó mới được đặt mật khẩu mới
  verifiedAt DateTime?
  /// Lúc đã đổi mật khẩu xong, hoặc bị thay bằng mã mới
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_otps")
}
