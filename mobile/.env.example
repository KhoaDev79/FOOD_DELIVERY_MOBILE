# Địa chỉ backend (dùng IP LAN của máy chạy backend khi test trên thiết bị thật)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
# Google Maps API key cho Android (react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Đăng nhập bằng Google (OAuth Client ID, không phải khoá bí mật) ----
# Tạo tại https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
